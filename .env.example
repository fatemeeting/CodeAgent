# DeepSeek API 配置模板
# 复制为 .env 并填入真实 key；.env 已被 .gitignore 忽略，绝不入库。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_CONTEXT_TOKENS=12000

# 可选开关（true/1 开启）
DEEPSEEK_REFLECT=false
DEEPSEEK_STREAM=false
DEEPSEEK_CONFIRM_DANGEROUS=false
# 开启思考：主模型切换为 deepseek-reasoner（显式设置 DEEPSEEK_MODEL 时以它为准）
DEEPSEEK_THINK=false
